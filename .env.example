# Copia este archivo a .env y completa los valores.
# .env está en .gitignore: nunca subas credenciales al repositorio.

# ---------------------------------------------------------------- Base de datos
# PostgreSQL. Con Neon (https://neon.tech, plan gratuito) la cadena se ve así:
# postgresql://usuario:clave@ep-xxx.sa-east-1.aws.neon.tech/ito?sslmode=require
#
# IMPORTANTE: si la conexión pasa por un pool (la cadena "-pooler" de Neon, PgBouncer,
# o el servidor local de `npx prisma dev`), agrega &pgbouncer=true al final. Sin eso
# Prisma falla con «prepared statement "s0" already exists».
DATABASE_URL="postgresql://usuario:clave@host:5432/ito?schema=public"

# ------------------------------------------------------------- Autenticación
# Secreto para firmar las sesiones. Genera uno con:  openssl rand -base64 32
AUTH_SECRET=""

# URL pública de la aplicación (en local puede quedar así).
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ------------------------------------------------------- Carga inicial (seed)
# Credenciales del primer usuario administrador. Cambia la contraseña al entrar.
SEED_ADMIN_EMAIL="admin@tuempresa.cl"
SEED_ADMIN_PASSWORD="Admin.2026"
